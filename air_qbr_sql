  -- 'aeromexico', 'air canada', 'alaska airlines', 'allegiant air',
  -- 'emirates', 'frontier airlines', 'united airlines', 'southwest airlines'
  -- )
  AND k.date_etz >= '2024-01-01' AND k.date_etz < date_trunc('QUARTER', CURRENT_DATE)
