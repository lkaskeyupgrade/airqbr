-- ============================================================
-- 7. Loan Term (daily breakdown) - has to be run seperately due ot the number of rows
-- ============================================================
SELECT
    k.partner_grouping_legacy, k.partner_short, k.date_etz,
    CAST(l.term AS STRING) AS loan_term,
    COUNT(*) AS loan_count
FROM commercial_analytics.public.kpi_dashboard k
JOIN databrickstors_canalytics_catalog.core.loan_issued_bnpl l
    ON CAST(l.loan_id AS STRING) = CAST(k.loan_id AS STRING)
WHERE lower(k.vertical) = 'air'
  -- AND lower(k.partner_grouping_legacy) IN (
  -- 'aeromexico', 'air canada', 'alaska airlines', 'allegiant air',
  -- 'emirates', 'frontier airlines', 'united airlines', 'southwest airlines'
  -- )
  AND k.date_etz >= '2024-01-01' AND k.date_etz < date_trunc('QUARTER', CURRENT_DATE)
GROUP BY 1, 2, 3, 4
ORDER BY 1, 2, 3, 4;


-- ============================================================
-- 8. Total Unique Customers
-- ============================================================
SELECT 
    COALESCE(pc1.partner_grouping, pc2.partner_grouping) AS partner_group,
    COALESCE(pc1.partner_short, pc2.partner_short)       AS partner_short,
    COALESCE(pc1.vertical, pc2.vertical)                 AS vertical,
    COUNT(DISTINCT a.legal_entity_id) AS total_unique_customers,
    MIN(a.application_create_date) AS partner_launch_date
FROM databrickstors_canalytics_catalog.core.application_bnpl a
JOIN databrickstors_canalytics_catalog.core.loan_issued_bnpl l
    ON l.application_uuid = a.application_uuid
LEFT JOIN commercial_analytics.public.partner_classification_aggregate pc1
    ON pc1.sdk_key_id = a.sdk_key_mapping_id
LEFT JOIN commercial_analytics.public.partner_classification_aggregate pc2
    ON pc2.upcode = a.uplift_upcode
WHERE lower(COALESCE(pc1.vertical, pc2.vertical)) = 'air'
  -- AND lower(COALESCE(pc1.partner_grouping, pc2.partner_grouping)) IN (
  -- 'aeromexico', 'air canada', 'alaska airlines', 'allegiant air',
  -- 'emirates', 'frontier airlines', 'united airlines', 'southwest airlines'
  -- )
GROUP BY 1, 2, 3
ORDER BY 1, 2;


-- ============================================================
-- 9. New vs Repeat Customers (Within Partner)
-- FIXED: a double-comma in the CTE before gmv_cad (same bug
-- pattern as queries 5/6).
-- FIXED: the "repeat" block was missing repeat_gmv_cad and
-- repeat_aov_usd entirely, and repeat_aov_cad was mismatched
-- with no repeat_gmv_cad alongside it. Now fully symmetric with
-- the "new" block: gmv_usd, gmv_cad, aov_usd, aov_cad for both
-- new and repeat.
-- ============================================================
WITH emirates_loans AS (
    SELECT 
        a.legal_entity_id,
        l.loan_id,
        TRY_CAST(k.gmv_usd AS DOUBLE) AS gmv_usd,
        TRY_CAST(k.gmv_cad AS DOUBLE) AS gmv_cad,
        COALESCE(pc1.vertical, pc2.vertical) AS vertical,
        DATE_TRUNC('quarter', from_utc_timestamp(l.origination_date, 'America/New_York')) AS loan_quarter,
        COALESCE(pc1.partner_short, pc2.partner_short) AS partner_short,
        COALESCE(pc1.partner_grouping, pc2.partner_grouping) AS partner_group,
        MIN(DATE_TRUNC('quarter', from_utc_timestamp(l.origination_date, 'America/New_York'))) OVER (
            PARTITION BY a.legal_entity_id
        ) AS first_emirates_quarter
    FROM databrickstors_canalytics_catalog.core.loan_issued_bnpl l
    JOIN databrickstors_canalytics_catalog.core.application_bnpl a
        ON a.application_uuid = l.application_uuid
    LEFT JOIN commercial_analytics.public.partner_classification_aggregate pc1
        ON pc1.sdk_key_id = a.sdk_key_mapping_id
    LEFT JOIN commercial_analytics.public.partner_classification_aggregate pc2
        ON pc2.upcode = a.uplift_upcode
    JOIN commercial_analytics.public.kpi_dashboard k
        ON k.loan_id = l.loan_id
    WHERE lower(COALESCE(pc1.vertical, pc2.vertical)) = 'air'
      -- AND lower(COALESCE(pc1.partner_grouping, pc2.partner_grouping)) IN (
      -- 'aeromexico', 'air canada', 'alaska airlines', 'allegiant air',
      -- 'emirates', 'frontier airlines', 'united airlines', 'southwest airlines'
      -- )
)
SELECT
    partner_group,
    partner_short,
    vertical,
    CONCAT('Q', QUARTER(loan_quarter), '-', YEAR(loan_quarter)) AS quarter,
    COUNT(DISTINCT CASE WHEN loan_quarter = first_emirates_quarter THEN legal_entity_id END) AS new_unique_customers,
    COUNT(CASE WHEN loan_quarter = first_emirates_quarter THEN loan_id END) AS new_loan_count,
    SUM(CASE WHEN loan_quarter = first_emirates_quarter THEN gmv_usd END) AS new_gmv_usd,
    SUM(CASE WHEN loan_quarter = first_emirates_quarter THEN gmv_cad END) AS new_gmv_cad,
    AVG(CASE WHEN loan_quarter = first_emirates_quarter THEN gmv_usd END) AS new_aov_usd,
    AVG(CASE WHEN loan_quarter = first_emirates_quarter THEN gmv_cad END) AS new_aov_cad,
    COUNT(DISTINCT CASE WHEN loan_quarter > first_emirates_quarter THEN legal_entity_id END) AS repeat_unique_customers,
    COUNT(CASE WHEN loan_quarter > first_emirates_quarter THEN loan_id END) AS repeat_loan_count,
    SUM(CASE WHEN loan_quarter > first_emirates_quarter THEN gmv_usd END) AS repeat_gmv_usd,
    SUM(CASE WHEN loan_quarter > first_emirates_quarter THEN gmv_cad END) AS repeat_gmv_cad,
    AVG(CASE WHEN loan_quarter > first_emirates_quarter THEN gmv_usd END) AS repeat_aov_usd,
    AVG(CASE WHEN loan_quarter > first_emirates_quarter THEN gmv_cad END) AS repeat_aov_cad,
    COUNT(DISTINCT legal_entity_id) AS total_unique_customers,
    COUNT(loan_id) AS total_loan_count,
    SUM(gmv_usd) AS total_gmv_usd,
    SUM(gmv_cad) AS total_gmv_cad,
    AVG(gmv_usd) AS total_aov_usd,
    AVG(gmv_cad) AS total_aov_cad,
    ROUND(100.0 * COUNT(DISTINCT CASE WHEN loan_quarter = first_emirates_quarter THEN legal_entity_id END) / NULLIF(COUNT(DISTINCT legal_entity_id), 0), 1) AS new_customer_pct,
    ROUND(100.0 * COUNT(DISTINCT CASE WHEN loan_quarter > first_emirates_quarter THEN legal_entity_id END) / NULLIF(COUNT(DISTINCT legal_entity_id), 0), 1) AS repeat_customer_pct
FROM emirates_loans
GROUP BY ALL
ORDER BY 1, 2, 4;


-- ============================================================
-- 10. Demographics (Age Generations / FICO)
-- NOTE: gmv/aov columns renamed to gmv_usd/aov_usd (from the
-- old plain gmv/aov) with new gmv_cad/aov_cad added alongside -
-- this is a real column-name change, not just an addition.
-- ============================================================
SELECT
    COALESCE(pc1.partner_grouping, pc2.partner_grouping) AS partner_group,
    COALESCE(pc1.partner_short, pc2.partner_short)       AS partner_short,
    COALESCE(pc1.vertical, pc2.vertical)                 AS vertical,
    CASE
        WHEN YEAR(a.date_of_birth) BETWEEN 2013 AND 2025 THEN 'Alpha'
        WHEN YEAR(a.date_of_birth) BETWEEN 1997 AND 2012 THEN 'Gen Z'
        WHEN YEAR(a.date_of_birth) BETWEEN 1981 AND 1996 THEN 'Gen Y (Millennials)'
        WHEN YEAR(a.date_of_birth) BETWEEN 1965 AND 1980 THEN 'Gen X'
        WHEN YEAR(a.date_of_birth) BETWEEN 1955 AND 1964 THEN 'Baby Boomers II'
        WHEN YEAR(a.date_of_birth) BETWEEN 1946 AND 1954 THEN 'Baby Boomers I'
        WHEN YEAR(a.date_of_birth) BETWEEN 1928 AND 1945 THEN 'Post War'
        WHEN YEAR(a.date_of_birth) BETWEEN 1922 AND 1927 THEN 'WWII'
        ELSE 'Unknown'
    END AS generation,
    CASE
        WHEN YEAR(from_utc_timestamp(l.origination_date, 'America/New_York')) = YEAR(CURRENT_DATE)
            THEN CONCAT('YTD ', YEAR(from_utc_timestamp(l.origination_date, 'America/New_York')))
        ELSE CONCAT('FY ', YEAR(from_utc_timestamp(l.origination_date, 'America/New_York')))
    END AS period,
    l.currency,
    COUNT(DISTINCT a.legal_entity_id) AS unique_customers,
    COUNT(l.loan_id) AS loan_count,
    SUM(TRY_CAST(k.gmv_usd AS DOUBLE)) AS gmv_usd,
    SUM(TRY_CAST(k.gmv_cad AS DOUBLE)) AS gmv_cad,
    AVG(TRY_CAST(k.gmv_usd AS DOUBLE)) AS aov_usd,
    AVG(TRY_CAST(k.gmv_cad AS DOUBLE)) AS aov_cad,
    ROUND(AVG((l.fico_range_low + l.fico_range_high) / 2.0), 0) AS avg_fico,
    ROUND(AVG(l.stated_annual_income), 0) AS avg_household_income
FROM databrickstors_canalytics_catalog.core.loan_issued_bnpl l
JOIN databrickstors_canalytics_catalog.core.application_bnpl a
    ON a.application_uuid = l.application_uuid
LEFT JOIN commercial_analytics.public.partner_classification_aggregate pc1
    ON pc1.sdk_key_id = a.sdk_key_mapping_id
LEFT JOIN commercial_analytics.public.partner_classification_aggregate pc2
    ON pc2.upcode = a.uplift_upcode
JOIN commercial_analytics.public.kpi_dashboard k
    ON k.loan_id = l.loan_id    
WHERE lower(COALESCE(pc1.vertical, pc2.vertical)) = 'air'
  -- AND lower(COALESCE(pc1.partner_grouping, pc2.partner_grouping)) IN (
  -- 'aeromexico', 'air canada', 'alaska airlines', 'allegiant air',
  -- 'emirates', 'frontier airlines', 'united airlines', 'southwest airlines'
  -- )
  AND YEAR(from_utc_timestamp(l.origination_date, 'America/New_York')) >= 2024
GROUP BY 1, 2, 3, 4, 5, 6
ORDER BY 1, 4, 3;


-- ============================================================
-- 11. Trip Duration (daily bucket breakdown)
-- ============================================================
SELECT
    partner_grouping_legacy,
    partner_short,
    date_etz,
    CASE
        WHEN trip_days < 7  THEN '<7d'
        WHEN trip_days < 15 THEN '7-14d'
        WHEN trip_days < 22 THEN '15-21d'
        WHEN trip_days < 31 THEN '22-30d'
        WHEN trip_days < 61 THEN '31-60d'
        ELSE '60d+'
    END AS trip_duration_bucket,
    COUNT(*) AS loan_count
FROM (
    SELECT
        k.partner_grouping_legacy,
        k.partner_short,
        k.date_etz,
        DATEDIFF(TRY_CAST(k.air_arrival_date AS DATE), TRY_CAST(k.air_departure_date AS DATE)) AS trip_days
    FROM commercial_analytics.public.kpi_dashboard k
    WHERE lower(k.vertical) = 'air'
      -- AND lower(k.partner_grouping_legacy) IN (
      -- 'aeromexico', 'air canada', 'alaska airlines', 'allegiant air',
      -- 'emirates', 'frontier airlines', 'united airlines', 'southwest airlines'
      -- )
      AND k.date_etz >= '2024-01-01'
      AND k.date_etz < date_trunc('QUARTER', CURRENT_DATE)
)
WHERE trip_days IS NOT NULL AND trip_days >= 0
GROUP BY 1, 2, 3, 4
ORDER BY 1, 2, 3, 4;
