WHERE lower(k.vertical) = 'air'
  -- AND lower(k.partner_grouping_legacy) IN (
  -- 'aeromexico', 'air canada', 'alaska airlines', 'allegiant air',
  -- 'emirates', 'frontier airlines', 'united airlines', 'southwest airlines'
  -- )
  AND k.date_etz >= '2024-01-01' AND k.date_etz < date_trunc('QUARTER', CURRENT_DATE)
GROUP BY 1, 2, 3, 4
ORDER BY 1, 2, 3, 4;


-- ============================================================
-- 4. Top 10 O&Ds
-- ============================================================
SELECT * FROM (
    SELECT
        partner_grouping_legacy,
        partner_short,
        air_od,
        SUM(TRY_CAST(loan_count AS DOUBLE)) AS loan_count,
        SUM(TRY_CAST(gmv_usd AS DOUBLE)) AS gmv_usd,
        SUM(TRY_CAST(gmv_cad AS DOUBLE)) AS gmv_cad,
        ROW_NUMBER() OVER (
            PARTITION BY partner_grouping_legacy, partner_short
            ORDER BY SUM(loan_count) DESC
        ) AS rank
    FROM commercial_analytics.public.kpi_dashboard
    WHERE lower(vertical) = 'air'
      -- AND lower(partner_grouping_legacy) IN (
      -- 'aeromexico', 'air canada', 'alaska airlines', 'allegiant air',
      -- 'emirates', 'frontier airlines', 'united airlines', 'southwest airlines'
      -- )
      AND TRY_CAST(date_etz AS DATE) >= ADD_MONTHS(CURRENT_DATE, -12)
      AND air_od IS NOT NULL
    GROUP BY ALL
)
WHERE rank <= 10
ORDER BY partner_grouping_legacy, partner_short, loan_count DESC;


-- ============================================================
-- 5. Top 10 Origins
-- FIXED: a double-comma before gmv_cad (trailing comma on the
-- gmv_usd line PLUS a leading comma on the next line) - invalid
-- SQL syntax, not just style.
-- ============================================================
SELECT * FROM (
    SELECT
        partner_grouping_legacy,
        partner_short,
        air_origin AS origin,
        SUM(TRY_CAST(loan_count AS DOUBLE)) AS loan_count,
        SUM(TRY_CAST(gmv_usd AS DOUBLE)) AS gmv_usd,
        SUM(TRY_CAST(gmv_cad AS DOUBLE)) AS gmv_cad,
        ROW_NUMBER() OVER (PARTITION BY partner_grouping_legacy, partner_short ORDER BY SUM(loan_count) DESC) AS rn
    FROM commercial_analytics.public.kpi_dashboard
    WHERE lower(vertical) = 'air'
      -- AND lower(partner_grouping_legacy) IN (
      -- 'aeromexico', 'air canada', 'alaska airlines', 'allegiant air',
      -- 'emirates', 'frontier airlines', 'united airlines', 'southwest airlines'
      -- )
      AND TRY_CAST(date_etz AS DATE) >= ADD_MONTHS(CURRENT_DATE, -12)
      AND air_origin IS NOT NULL
    GROUP BY ALL
)
WHERE rn <= 10
ORDER BY partner_grouping_legacy, partner_short, loan_count DESC;


