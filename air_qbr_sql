ORDER BY 1, 2, 3, 4;


-- ============================================================
-- 3. Fare Class (daily breakdown)
-- ============================================================
SELECT
    k.partner_grouping_legacy, k.partner_short, k.date_etz,
    TRIM(SPLIT(k.air_fare_classes, '|')[0]) AS fare_class,
    COUNT(*) AS loan_count
