-- ============================================================
-- Air Vertical QBR: CONSOLIDATED, CURRENT QUERY SET (with CAD)
-- Vertical/partner filters use lower(...) on both sides for
-- robustness against any casing inconsistency (not just the
-- specific 'AIR' vs 'Air' issue found earlier).
-- Queries 8-10 (Total Unique Customers / New vs Repeat /
-- Demographics) use partner_classification_aggregate (pc),
-- joined two ways via LEFT JOIN + COALESCE: first
-- pc1.sdk_key_id = a.sdk_key_mapping_id, falling back to
-- pc2.upcode = a.uplift_upcode when the first doesn't match.
-- Queries 1-7 use k.partner_grouping_legacy/k.partner_short/
-- k.vertical directly.
--
-- CAD ADDED: every gmv_usd-style column now has a gmv_cad
-- counterpart, sourced from k.gmv_cad (raw, pre-computed local-
-- currency amount, same source table as gmv_usd - no FX
-- conversion happens in these queries or in the dashboard).
-- ============================================================


-- ============================================================
-- 1. Daily Metrics (continuous)
-- FIXED: removed a duplicate subvented_gmv_cad column (was
-- defined twice - a real syntax error), added the missing
-- unconditional gmv_cad total (gmv_usd had one, gmv_cad didn't).
-- ============================================================
SELECT
    k.partner_grouping_legacy,
    k.partner_short,
    k.date_etz,
    COUNT(*)                                                          AS loan_count,
    SUM(TRY_CAST(k.gmv_usd AS DOUBLE))                                AS gmv_usd,
    SUM(TRY_CAST(k.gmv_cad AS DOUBLE))                                AS gmv_cad,
    SUM(CASE WHEN k.is_subvented = TRUE  THEN TRY_CAST(k.gmv_usd AS DOUBLE) ELSE 0 END) AS subvented_gmv_usd,
    SUM(CASE WHEN k.is_subvented = TRUE  THEN TRY_CAST(k.gmv_cad AS DOUBLE) ELSE 0 END) AS subvented_gmv_cad,
    SUM(CASE WHEN k.is_subvented = FALSE THEN TRY_CAST(k.gmv_usd AS DOUBLE) ELSE 0 END) AS interest_bearing_gmv_usd,
    SUM(CASE WHEN k.is_subvented = FALSE THEN TRY_CAST(k.gmv_cad AS DOUBLE) ELSE 0 END) AS interest_bearing_gmv_cad,
    SUM(TRY_CAST(k.num_of_travelers_incl_minors AS DOUBLE))           AS passengers,
    AVG(TRY_CAST(k.booking_window AS DOUBLE))                         AS avg_booking_window,
    AVG(TRY_CAST(k.fico AS DOUBLE))                                   AS avg_fico
FROM commercial_analytics.public.kpi_dashboard k
WHERE lower(k.vertical) = 'air'
  -- AND lower(k.partner_grouping_legacy) IN (
  -- 'aeromexico', 'air canada', 'alaska airlines', 'allegiant air',
  -- 'emirates', 'frontier airlines', 'united airlines', 'southwest airlines'
  -- )
  AND k.date_etz >= '2024-01-01'
  AND k.date_etz < date_trunc('QUARTER', CURRENT_DATE)
GROUP BY 1, 2, 3
ORDER BY 1, 2, 3;


-- ============================================================
-- 2. Device Type (daily breakdown)
