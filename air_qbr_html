<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Air Vertical QBR</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/pako/2.1.0/pako.min.js"></script>
<style>
:root{--g1:#0B530B;--g2:#0E680E;--g3:#2B811D;--g4:#499B2D;--g5:#88BE76;--g6:#BFDCB5;
  --light:#EAF2E6;--bg:#F4F8F2;--sf:#FFFFFF;--bd:#CCDFC7;--bl:#DFF0DA;
  --tx:#0D1F09;--mu:#3D6030;--fa:#7DA870;--r:10px;--sh:0 1px 3px rgba(0,0,0,.08)}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;background:var(--bg);color:var(--tx);font-size:14px}
.hd{background:var(--g1);padding:12px 22px;display:flex;align-items:center;justify-content:space-between}
.hd-l{display:flex;align-items:center;gap:11px}
.hbar{width:5px;height:34px;background:var(--g3);border-radius:3px}
.hd h1{font-size:16px;font-weight:600;color:#fff;letter-spacing:-.3px}
.hd-s{font-size:11px;color:rgba(255,255,255,.55);margin-top:2px}
.hd-r{font-size:11px;color:rgba(255,255,255,.45);text-align:right;line-height:1.7}

/* LOAD SCREEN */
.load-screen{display:flex;align-items:center;justify-content:center;height:calc(100vh - 60px);flex-direction:column;gap:14px}
.load-card{background:var(--sf);border:1px solid var(--bd);border-radius:var(--r);padding:36px 44px;box-shadow:var(--sh);text-align:center;max-width:420px}
.load-card h2{font-size:16px;margin-bottom:8px}
.load-card p{font-size:12px;color:var(--mu);margin-bottom:18px;line-height:1.5}
.load-btn{background:var(--g2);color:#fff;border:none;padding:9px 22px;border-radius:8px;font-size:13px;font-weight:500;cursor:pointer}
.load-btn:hover{background:var(--g1)}
.load-err{color:#B23A3A;font-size:12px;margin-top:10px}
#file-input{display:none}

/* FILTER BAR */
.fb{background:var(--sf);border-bottom:1px solid var(--bd);padding:7px 22px;display:flex;align-items:center;gap:10px;flex-wrap:wrap;position:sticky;top:0;z-index:100;box-shadow:0 1px 4px rgba(0,0,0,.06)}
.fbl{font-size:10px;font-weight:600;color:var(--mu);text-transform:uppercase;letter-spacing:.5px;white-space:nowrap}
.fbg{display:flex;gap:3px;flex-wrap:wrap}
.fbb{padding:3px 10px;font-size:11px;font-weight:500;border:1px solid var(--bd);border-radius:12px;cursor:pointer;background:none;color:var(--mu);transition:all .12s;white-space:nowrap}
.fbb:hover{border-color:var(--g3);color:var(--g2)}
.fbb.active{background:var(--g2);border-color:var(--g2);color:#fff}
.fbdv{width:1px;height:16px;background:var(--bd);flex-shrink:0}
.fbsl{font-size:11px;color:var(--mu);background:var(--bg);border:1px solid var(--bd);border-radius:6px;padding:2px 6px;font-family:inherit}
.fbsl:focus{outline:none;border-color:var(--g3)}
.arl{font-size:11px;color:var(--g2);font-weight:500;background:var(--light);padding:2px 9px;border-radius:11px;border:1px solid var(--bd);white-space:nowrap}
.psel{font-size:12px;font-weight:600;color:var(--tx);background:var(--sf);border:1px solid var(--bd);border-radius:8px;padding:4px 10px;font-family:inherit;min-width:160px}
.psel:focus{outline:none;border-color:var(--g3)}

/* LAYOUT */
.shell{display:flex;height:calc(100vh - 90px)}
.sb{width:182px;flex-shrink:0;background:var(--sf);border-right:1px solid var(--bd);padding:8px 0;position:sticky;top:90px;height:calc(100vh - 90px);overflow-y:auto}
.ns{font-size:10px;font-weight:600;letter-spacing:.8px;text-transform:uppercase;color:var(--fa);padding:8px 13px 3px}
.ni{display:flex;align-items:center;gap:6px;padding:6px 13px;cursor:pointer;font-size:12px;color:var(--mu);border-left:3px solid transparent;transition:all .12s;white-space:nowrap}
.ni:hover{color:var(--tx);background:#F0F5EE}
.ni.active{color:var(--g2);border-left-color:var(--g2);background:var(--light);font-weight:500}
.nd{width:5px;height:5px;border-radius:50%;background:currentColor;flex-shrink:0}

.main{flex:1;padding:16px 20px;overflow-y:auto}
.pg{display:none}.pg.active{display:block}
.pt{font-size:16px;font-weight:600;letter-spacing:-.3px;margin-bottom:2px}
.ps{font-size:11px;color:var(--mu);margin-bottom:13px}

.ptbar{display:flex;gap:5px;margin-bottom:11px;flex-wrap:wrap;align-items:center}
.ptlbl{font-size:10px;color:var(--mu);margin-right:2px;text-transform:uppercase;letter-spacing:.4px}
.ptt{padding:3px 11px;font-size:11px;font-weight:500;border:1px solid var(--bd);border-radius:13px;cursor:pointer;background:var(--sf);color:var(--mu);transition:all .12s}
.ptt:hover{border-color:var(--g3);color:var(--g2)}
.ptt.active{background:var(--g2);border-color:var(--g2);color:#fff}

.card{background:var(--sf);border:1px solid var(--bd);border-radius:var(--r);padding:12px 15px;box-shadow:var(--sh)}
.ct{font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:.5px;color:var(--mu);margin-bottom:8px}
.g2{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin-bottom:9px}
.g3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:9px;margin-bottom:9px}
.cw{position:relative;width:100%}

.kr{display:grid;grid-template-columns:repeat(6,1fr);gap:7px;margin-bottom:11px}
.kpi{background:var(--sf);border:1px solid var(--bd);border-radius:var(--r);padding:10px 12px;box-shadow:var(--sh)}
.kpi.ak{border-left:3px solid var(--g2)}
.kl{font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:.5px;color:var(--fa);margin-bottom:3px}
.kv{font-size:19px;font-weight:600;letter-spacing:-.5px;line-height:1}
.ks{font-size:10px;color:var(--fa);margin-top:3px}

table.dt{width:100%;border-collapse:collapse;font-size:12px}
table.dt th{text-align:left;font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:.4px;color:var(--fa);padding:4px 6px;border-bottom:1px solid var(--bd)}
table.dt th.r{text-align:right}
table.dt td{padding:5px 6px;border-bottom:1px solid var(--bl);color:var(--tx)}
table.dt td.r{text-align:right;font-variant-numeric:tabular-nums}
table.dt tr:last-child td{border-bottom:none}
table.dt tr:hover td{background:#F5FAF3}
.rb{display:inline-block;width:17px;height:17px;border-radius:4px;background:var(--bg);color:var(--mu);font-size:10px;font-weight:600;text-align:center;line-height:17px}

.bt{background:#E8F2E4;border-radius:3px;height:12px;overflow:hidden}
.bf{height:100%;border-radius:3px}

.ptog{padding:3px 10px;font-size:11px;border:1px solid var(--bd);border-radius:13px;cursor:pointer;background:none;color:var(--mu);transition:all .12s}
.ptog.active{background:var(--bg);color:var(--tx);font-weight:500;border-color:#A5C89E}
.ptogrow{display:flex;gap:5px;margin-bottom:9px;flex-wrap:wrap}
.note{font-size:11px;color:var(--mu);background:#FFFDF5;border:1px solid #D5C97A;border-radius:6px;padding:6px 10px;margin-top:8px;line-height:1.5}
</style>
</head>
<body>

<div id="load-screen" class="load-screen">
  <div class="load-card">
    <h2>Air Vertical QBR</h2>
    <p>Load the data file (<code>air_qbr_data.json.gz</code>) to open the dashboard. Nothing is embedded in this HTML file - all data loads fresh each time you open it, so this file always reflects whatever data file you point it at.</p>
    <button class="load-btn" onclick="document.getElementById('file-input').click()">Load Data File</button>
    <input type="file" id="file-input" accept=".gz,.json" onchange="handleFileLoad(event)">
    <div id="load-err" class="load-err"></div>
  </div>
</div>

<div id="dashboard-root" style="display:none">
<div class="hd">
  <div class="hd-l"><div class="hbar"></div>
    <div><h1>Air Vertical QBR</h1><div class="hd-s" id="hd-sub">&nbsp;</div></div>
  </div>
  <div class="hd-r" id="hd-r">&nbsp;</div>
</div>

<div class="fb">
  <span class="fbl">Partner:</span>
  <select class="psel" id="partner-select" onchange="onPartnerChange()"></select>
  <div class="fbdv"></div>
  <span class="fbl">View:</span>
  <div class="fbg">
    <button class="fbb" onclick="setGrain('day',this)">Day</button>
    <button class="fbb active" onclick="setGrain('month',this)">Month</button>
    <button class="fbb" onclick="setGrain('quarter',this)">Quarter</button>
    <button class="fbb" onclick="setGrain('year',this)">Year</button>
    <button class="fbb" onclick="setGrain('aggregated',this)">Aggregated</button>
  </div>
  <div class="fbdv"></div>
  <span class="fbl">Quick:</span>
  <div class="fbg" id="quick-btns"></div>
  <div class="fbdv"></div>
  <span class="fbl">From:</span>
  <input type="date" class="fbsl" id="sel-from" onchange="setCR()">
  <span class="fbl">To:</span>
  <input type="date" class="fbsl" id="sel-to" onchange="setCR()">
  <div class="fbdv"></div>
  <span class="arl" id="arl">&nbsp;</span>
</div>

<div class="shell">
  <div class="sb">
    <div class="ns">Overview</div>
    <div class="ni active" onclick="nav('summary',this)"><span class="nd"></span>Summary</div>
    <div class="ns">Core KPIs</div>
    <div class="ni" onclick="nav('loans',this)"><span class="nd"></span>Loans</div>
    <div class="ni" onclick="nav('gmv',this)"><span class="nd"></span>GMV &amp; AOV</div>
    <div class="ni" onclick="nav('sub',this)"><span class="nd"></span>Subvention</div>
    <div class="ni" onclick="nav('bw',this)"><span class="nd"></span>Booking Window</div>
    <div class="ni" onclick="nav('fico',this)"><span class="nd"></span>FICO</div>
    <div class="ni" onclick="nav('pax',this)"><span class="nd"></span>Passengers</div>
    <div class="ni" onclick="nav('term',this)"><span class="nd"></span>Loan Term</div>
    <div class="ni" onclick="nav('device',this)"><span class="nd"></span>Device Type</div>
    <div class="ni" onclick="nav('fare',this)"><span class="nd"></span>Fare Class</div>
    <div class="ns">Customers</div>
    <div class="ni" onclick="nav('uniq',this)"><span class="nd"></span>Unique Customers</div>
    <div class="ni" onclick="nav('rep',this)"><span class="nd"></span>New vs Repeat</div>
    <div class="ni" onclick="nav('gen',this)"><span class="nd"></span>Generation Mix</div>
    <div class="ns">Routes</div>
    <div class="ni" onclick="nav('od',this)"><span class="nd"></span>Top O&amp;Ds</div>
    <div class="ni" onclick="nav('orig',this)"><span class="nd"></span>Top Origins</div>
    <div class="ni" onclick="nav('dest',this)"><span class="nd"></span>Top Destinations</div>
  </div>

  <div class="main">
    <div id="page-summary" class="pg active"></div>
    <div id="page-loans" class="pg"></div>
    <div id="page-gmv" class="pg"></div>
    <div id="page-sub" class="pg"></div>
    <div id="page-bw" class="pg"></div>
    <div id="page-fico" class="pg"></div>
    <div id="page-pax" class="pg"></div>
    <div id="page-term" class="pg"></div>
    <div id="page-device" class="pg"></div>
    <div id="page-fare" class="pg"></div>
    <div id="page-uniq" class="pg"></div>
    <div id="page-rep" class="pg"></div>
    <div id="page-gen" class="pg"></div>
    <div id="page-od" class="pg"></div>
    <div id="page-orig" class="pg"></div>
    <div id="page-dest" class="pg"></div>
  </div>
</div>
</div>

<script>
// ── FILE LOADING ─────────────────────────────────────────────────────
let DATA = null;       // parsed full dataset after decompression
let PARTNERS = [];     // sorted list of distinct partner_grouping values
let currentPartner = null;
let channels = [];     // distinct partner_short values under currentPartner
let DATES = [];        // ISO date strings spanning the loaded data's range
let DATES_MIN_IDX = 0; // raw day-index corresponding to DATES[0], for O(1) position lookup
let EPOCH = null;

function handleFileLoad(event) {
  const file = event.target.files[0];
  if (!file) return;
  const errEl = document.getElementById('load-err');
  errEl.textContent = '';
  const reader = new FileReader();
  reader.onload = function(e) {
    try {
      const buf = new Uint8Array(e.target.result);
      let text;
      // Detect gzip magic bytes (1f 8b) vs plain JSON
      if (buf[0] === 0x1f && buf[1] === 0x8b) {
        text = pako.inflate(buf, { to: 'string' });
      } else {
        text = new TextDecoder('utf-8').decode(buf);
      }
      DATA = JSON.parse(text);
      initDashboard();
    } catch (err) {
      errEl.textContent = 'Could not load this file: ' + err.message;
      console.error(err);
    }
  };
  reader.onerror = function() {
    errEl.textContent = 'File read error.';
  };
  reader.readAsArrayBuffer(file);
}

function initDashboard() {
  EPOCH = new Date(DATA.epoch + 'T00:00:00Z');

  // Build sorted partner list from daily_metrics (most complete source)
  const pset = new Set();
  DATA.daily_metrics.forEach(r => pset.add(r[0]));
  PARTNERS = Array.from(pset).sort();

  // Build global DATES range spanning min/max date_idx across daily_metrics
  let minIdx = Infinity, maxIdx = -Infinity;
  DATA.daily_metrics.forEach(r => {
    const idx = r[2];
    if (idx == null) return;
    if (idx < minIdx) minIdx = idx;
    if (idx > maxIdx) maxIdx = idx;
  });
  DATES_MIN_IDX = minIdx;
  DATES = [];
  for (let i = minIdx; i <= maxIdx; i++) {
    const d = new Date(EPOCH.getTime() + i * 86400000);
    DATES.push(d.toISOString().slice(0,10));
  }

  // Populate partner selector
  const sel = document.getElementById('partner-select');
  sel.innerHTML = PARTNERS.map(p => `<option value="${p}">${p}</option>`).join('');
  currentPartner = PARTNERS[0];
  sel.value = currentPartner;

  // Populate quick-filter buttons based on actual data year range
  buildQuickButtons();

  // Set up date pickers
  document.getElementById('sel-from').min = DATES[0];
  document.getElementById('sel-from').max = DATES[DATES.length-1];
  document.getElementById('sel-to').min = DATES[0];
  document.getElementById('sel-to').max = DATES[DATES.length-1];
  document.getElementById('sel-from').value = DATES[0];
  document.getElementById('sel-to').value = DATES[DATES.length-1];
  rfrom = 0; rto = DATES.length - 1;
  filFrom = DATES[0]; filTo = DATES[DATES.length-1];

  document.getElementById('load-screen').style.display = 'none';
  document.getElementById('dashboard-root').style.display = 'block';
  document.getElementById('hd-r').innerHTML = DATES[0] + ' – ' + DATES[DATES.length-1];

  onPartnerChange();
}

function buildQuickButtons() {
  const years = new Set();
  DATES.forEach(d => years.add(d.slice(0,4)));
  const sortedYears = Array.from(years).sort();
  const container = document.getElementById('quick-btns');
  let html = '';
  sortedYears.forEach(y => {
    html += `<button class="fbb" onclick="setQuickYear('${y}',this)">FY ${y}</button>`;
  });
  html += `<button class="fbb active" onclick="setQuickAll(this)">All time</button>`;
  container.innerHTML = html;
}

// ── FILTER STATE ──────────────────────────────────────────────────────
let grain = 'month', rfrom = 0, rto = 0;
let filFrom = '', filTo = '';

function setCR() {
  const f = document.getElementById('sel-from').value;
  const t = document.getElementById('sel-to').value;
  if (f > t) { document.getElementById('sel-to').value = f; return; }
  rfrom = DATES.indexOf(f); if (rfrom < 0) rfrom = 0;
  rto = DATES.indexOf(t); if (rto < 0) rto = DATES.length - 1;
  filFrom = f; filTo = t;
  document.querySelectorAll('#quick-btns .fbb').forEach(b => b.classList.remove('active'));
  updateLbl(); renderAll();
}

function setQuickYear(y, el) {
  document.querySelectorAll('#quick-btns .fbb').forEach(b => b.classList.remove('active'));
  el.classList.add('active');
  const f = y + '-01-01', t = y + '-12-31';
  document.getElementById('sel-from').value = f;
  document.getElementById('sel-to').value = t;
  rfrom = DATES.indexOf(f); if (rfrom < 0) rfrom = 0;
  rto = DATES.indexOf(t); if (rto < 0) rto = DATES.length - 1;
  filFrom = f; filTo = t;
  updateLbl(); renderAll();
}

function setQuickAll(el) {
  document.querySelectorAll('#quick-btns .fbb').forEach(b => b.classList.remove('active'));
  el.classList.add('active');
  document.getElementById('sel-from').value = DATES[0];
  document.getElementById('sel-to').value = DATES[DATES.length-1];
  rfrom = 0; rto = DATES.length - 1;
  filFrom = '0000-01-01'; filTo = '9999-12-31'; // wide open for quarter-based sections (New vs Repeat)
  updateLbl(); renderAll();
}

function setGrain(g, el) {
  grain = g;
  document.querySelectorAll('.fb .fbg')[0].querySelectorAll('.fbb').forEach(b => b.classList.remove('active'));
  el.classList.add('active');
  renderAll();
}

function updateLbl() {
  const f = document.getElementById('sel-from').value;
  const t = document.getElementById('sel-to').value;
  document.getElementById('arl').textContent = f + ' \u2013 ' + t;
}

function onPartnerChange() {
  currentPartner = document.getElementById('partner-select').value;
  const chSet = new Set();
  DATA.daily_metrics.forEach(r => { if (r[0] === currentPartner) chSet.add(r[1]); });
  channels = Array.from(chSet).sort();
  document.getElementById('hd-sub').textContent = currentPartner + ' \u00b7 ' + channels.length + ' channel' + (channels.length===1?'':'s');
  renderAll();
}

function nav(page, el) {
  document.querySelectorAll('.ni').forEach(n => n.classList.remove('active'));
  el.classList.add('active');
  document.querySelectorAll('.pg').forEach(p => p.classList.remove('active'));
  document.getElementById('page-' + page).classList.add('active');
}

// ── PALETTE & FORMATTING ─────────────────────────────────────────────
const PALETTE = ['#0B530B','#0E680E','#2B811D','#499B2D','#88BE76','#BFDCB5'];
const AMBER = '#E0A239'; // reserved for highlight series (repeat %, interest-bearing) - not part of the per-channel rotation
function colorFor(i) { return PALETTE[i % PALETTE.length]; }

function fm(v) {
  if (v == null || isNaN(v)) return '$0';
  return '$' + Math.round(v).toLocaleString();
}
function fmS(v) {
  if (v == null || isNaN(v)) return '$0';
  const a = Math.abs(v);
  if (a >= 1e6) return '$' + (v/1e6).toFixed(1) + 'M';
  if (a >= 1e3) return '$' + (v/1e3).toFixed(0) + 'K';
  return '$' + Math.round(v);
}
function hexToRgba(hex, alpha) {
  const h = hex.replace('#','');
  const r = parseInt(h.substring(0,2),16), g = parseInt(h.substring(2,4),16), b = parseInt(h.substring(4,6),16);
  return `rgba(${r},${g},${b},${alpha})`;
}
function legendLabels() {
  return {font:{size:10},boxWidth:10,padding:7,usePointStyle:true,
    generateLabels: chart => chart.data.datasets.map((ds,i)=>({
      text: ds.label, fillStyle: ds.borderColor, strokeStyle: ds.borderColor,
      lineWidth: 0, hidden: !chart.isDatasetVisible(i), datasetIndex: i, pointStyle: 'circle'
    }))};
}

// ── GENERIC AGGREGATION ENGINE ───────────────────────────────────────
function bucketLabel(dateIdx, g) {
  const d = new Date(EPOCH.getTime() + dateIdx*86400000);
  const y = d.getUTCFullYear(), mo = d.getUTCMonth()+1;
  if (g==='day') return d.toISOString().slice(0,10);
  if (g==='month') return `${y}-${String(mo).padStart(2,'0')}`;
  if (g==='quarter') return `Q${Math.ceil(mo/3)}-${y}`;
  if (g==='year') return String(y);
  return 'All';
}
function bucketSort(a, b) {
  // day/month sort lexically fine; quarter needs numeric year+quarter sort
  if (a.startsWith('Q') && b.startsWith('Q')) {
    const [qa, ya] = a.slice(1).split('-'); const [qb, yb] = b.slice(1).split('-');
    return ya !== yb ? ya - yb : qa - qb;
  }
  return a < b ? -1 : a > b ? 1 : 0;
}

// Filters daily_metrics to current partner + selected date range, returns
// { channel: { bucketLabel: {loans, gmv, sub, int, pax, bwSum, bwCount, ficoSum, ficoCount} } }
function aggregateDailyMetrics() {
  const result = {};
  channels.forEach(c => result[c] = {});
  const fromIdx = DATES.indexOf(filFrom) >= 0 ? DATES.indexOf(filFrom) : rfrom;
  const toIdx = DATES.indexOf(filTo) >= 0 ? DATES.indexOf(filTo) : rto;
  const minDay = EPOCH ? Math.min.apply(null, DATES.map((_,i)=>i)) : 0;

  DATA.daily_metrics.forEach(row => {
    const [partner, channel, dateIdx, loans, gmv, sub, intr, pax, bw, fico] = row;
    if (partner !== currentPartner || dateIdx == null) return;
    const dPos = dateIdx - DATES_MIN_IDX;
    if (dPos < rfrom || dPos > rto) return;
    const label = bucketLabel(dateIdx, grain);
    if (!result[channel]) result[channel] = {};
    if (!result[channel][label]) result[channel][label] = {loans:0,gmv:0,sub:0,int:0,pax:0,bwSum:0,bwCount:0,ficoSum:0,ficoCount:0};
    const b = result[channel][label];
    b.loans += (loans||0); b.gmv += (gmv||0); b.sub += (sub||0); b.int += (intr||0); b.pax += (pax||0);
    if (bw != null && loans) { b.bwSum += bw*loans; b.bwCount += loans; }
    if (fico != null && loans) { b.ficoSum += fico*loans; b.ficoCount += loans; }
  });
  return result;
}

function allBucketLabels(aggResult) {
  const s = new Set();
  channels.forEach(c => { if (aggResult[c]) Object.keys(aggResult[c]).forEach(l => s.add(l)); });
  return Array.from(s).sort(bucketSort);
}

let charts = {};
function mk(id, config) {
  const canvas = document.getElementById(id);
  if (!canvas) return;
