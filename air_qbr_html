// ── CATEGORY BREAKDOWNS (Term / Device / Fare) ───────────────────────
function cleanCatLabel(v) {
  const s = v == null ? 'Unknown' : String(v);
  return s.match(/^\d+\.0$/) ? s.slice(0, -2) : s;
}
function aggregateCategory(dataset, sortFn) {
  // dataset rows: [partner, channel, date_idx, category, loan_count]
  const result = {}; // channel -> category -> count
  const allCats = new Set();
  dataset.forEach(row => {
    const partner = row[0], channel = row[1], dateIdx = row[2], cat = row[3], count = row[4];
    if (partner !== currentPartner || dateIdx == null) return;
    const dPos = dateIdx - DATES_MIN_IDX;
    if (dPos < rfrom || dPos > rto) return;
    if (!result[channel]) result[channel] = {};
    const c = cleanCatLabel(cat);
    result[channel][c] = (result[channel][c]||0) + (count||0);
    allCats.add(c);
  });
  const categories = Array.from(allCats).sort(sortFn || undefined);
  return { result, categories };
}
function numericSort(a, b) {
  const na = parseFloat(a), nb = parseFloat(b);
  if (!isNaN(na) && !isNaN(nb)) return na - nb;
  return a < b ? -1 : a > b ? 1 : 0;
}

function renderCategoryPage(pageId, dataset, title, sub, sortFn) {
  const { result, categories } = aggregateCategory(dataset, sortFn);
  const el = document.getElementById(pageId);
  el.innerHTML = `
    <div class="pt">${title}</div><div class="ps">${sub}</div>
