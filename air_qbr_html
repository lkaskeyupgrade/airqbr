// ── GENERATION MIX ────────────────────────────────────────────────────
const GEN_ORDER = ['WWII','Post War','Baby Boomers I','Baby Boomers II','Gen X','Gen Y (Millennials)','Gen Z','Alpha','Unknown'];
function genSort(a, b) {
  const ia = GEN_ORDER.indexOf(a), ib = GEN_ORDER.indexOf(b);
  if (ia === -1 && ib === -1) return a < b ? -1 : a > b ? 1 : 0;
  if (ia === -1) return 1;
  if (ib === -1) return -1;
  return ia - ib;
}
let genPeriod = null;
function setGenPeriod(p, el) {
