  `).join('');
  channels.forEach((c,i) => {
    const vals = categories.map(cat => (result[c]&&result[c][cat]) || 0);
    mk(pageId+'-c'+i, {type:'bar', data:{labels:categories, datasets:[{data:vals, backgroundColor:colorFor(i), borderRadius:3}]},
      options:{responsive:true,maintainAspectRatio:false, plugins:{legend:{display:false}}, scales:{x:xO,y:yO}}});
  });
}

